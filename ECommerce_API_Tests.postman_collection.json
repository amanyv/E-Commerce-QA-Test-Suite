              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('New access token is returned and differs from the old one', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.expect(json.accessToken).to.not.eql(pm.environment.get('access_token'));",
                  "    pm.environment.set('access_token', json.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Token is rejected on reuse after logout', function () {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get('base_url') + '/api/orders',",
                  "        method: 'GET',",
                  "        header: { Authorization: 'Bearer ' + pm.environment.get('access_token') }",
                  "    }, function (err, res) {",
                  "        pm.expect(res.code).to.eql(401);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Registration, login, token refresh, and logout endpoints."
