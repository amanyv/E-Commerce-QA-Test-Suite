{
  "info": {
    "_postman_id": "b3cff2d6-a5c0-4d46-b97d-21e39b05a655",
    "name": "E-Commerce Web App - API Test Suite",
    "description": "Postman collection for the E-Commerce Web App QA project. Covers Auth, Orders, and Inventory REST endpoints with assertions on status codes, response schemas, and error payloads. A pre-request script at the collection level ensures test_email is unique per run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a unique test email once per collection run so 'Register' tests are repeatable",
          "if (!pm.environment.get('test_email')) {",
          "    const rand = Math.floor(Math.random() * 1000000);",
          "    pm.environment.set('test_email', `qa.tester+${rand}@example.com`);",
          "    pm.environment.set('test_password', 'Test@1234');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.ecommerce-demo.test"
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "address_id",
      "value": ""
    },
    {
      "key": "payment_method_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "shipped_order_id",
      "value": ""
    },
    {
