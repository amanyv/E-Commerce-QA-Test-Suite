        {
          "name": "Create Order - Valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"shippingAddressId\": \"{{address_id}}\",\n  \"paymentMethodId\": \"{{payment_method_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Order response matches expected schema', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.all.keys(['orderId', 'status', 'items', 'subtotal', 'tax', 'shipping', 'total', 'createdAt']);",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "    pm.environment.set('order_id', json.orderId);",
                  "});",
                  "",
                  "pm.test('Total equals subtotal + tax + shipping', function () {",
                  "    const json = pm.response.json();",
                  "    const expected = Math.round((json.subtotal + json.tax + json.shipping) * 100) / 100;",
                  "    pm.expect(json.total).to.eql(expected);",
                  "});"
                ]
              }
            }
          ]
        },
