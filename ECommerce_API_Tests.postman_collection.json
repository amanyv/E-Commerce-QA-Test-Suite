        {
          "name": "List Products - Search & Filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/inventory/products?q=laptop&category=electronics&minPrice=200&maxPrice=1500",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "inventory",
                "products"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "laptop"
                },
                {
                  "key": "category",
                  "value": "electronics"
                },
                {
                  "key": "minPrice",
                  "value": "200"
                },
                {
                  "key": "maxPrice",
                  "value": "1500"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All returned products respect the price filter', function () {",
                  "    const json = pm.response.json();",
                  "    json.items.forEach((p) => {",
                  "        pm.expect(p.price).to.be.at.least(200);",
